rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Identifikasi peran Admin Sekolah
    function isAdmin() {
      return (isSignedIn() && (
        request.auth.token.email in ['raharjofamily81@gmail.com', 'simasop2008@gmail.com', 'admin@sekolah.id', 'sstanjung2008@gmail.com'] ||
        (request.auth.token.email_verified == true && request.auth.token.email in ['raharjofamily81@gmail.com', 'simasop2008@gmail.com', 'admin@sekolah.id', 'sstanjung2008@gmail.com']) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN') ||
        request.auth.token.role == 'ADMIN'
      ));
    }

    // Identifikasi peran Guru & Admin Guru
    function isTeacher() {
      return (isSignedIn() && (
        request.auth.token.role in ['TEACHER', 'GURU', 'ADMIN_GURU'] ||
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/sihadir_teachers/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['TEACHER', 'GURU', 'ADMIN_GURU'])
      ));
    }

    function isTeacherOrAdmin() {
      return isAdmin() || isTeacher();
    }

    // Helper validasi presensi: menolak payload rusak, oversized, atau tanpa field inti
    function isValidAttendanceRecord(data) {
      return data.id is string && data.id.size() <= 128
        && data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 64
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.status is string && data.status.size() <= 32
        && (!('time' in data) || (data.time is string && data.time.size() <= 32))
        && (!('returnTime' in data) || (data.returnTime is string && data.returnTime.size() <= 32))
        && (!('returnStatus' in data) || (data.returnStatus is string && data.returnStatus.size() <= 32))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('studentName' in data) || (data.studentName is string && data.studentName.size() <= 200))
        && (!('className' in data) || (data.className is string && data.className.size() <= 64));
    }

    // Mencegah penulisan sia-sia (no-op write): menolak update jika data identik dengan yang ada di cloud
    function isMeaningfulAttendanceUpdate() {
      return incoming().status != existing().status
        || (('time' in incoming()) && (!('time' in existing()) || incoming().time != existing().time))
        || (('returnTime' in incoming()) && (!('returnTime' in existing()) || incoming().returnTime != existing().returnTime))
        || (('returnStatus' in incoming()) && (!('returnStatus' in existing()) || incoming().returnStatus != existing().returnStatus))
        || (('notes' in incoming()) && (!('notes' in existing()) || incoming().notes != existing().notes))
        || (('updatedAt' in incoming()) && ('updatedAt' in existing()) && incoming().updatedAt > (existing().updatedAt + 1000));
    }

    // Helper validasi catatan karakter: menolak skor tidak valid atau tanpa identitas siswa
    function isValidCharacterLog(data) {
      return data.id is string && data.id.size() <= 128
        && data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 64
        && data.traitName is string && data.traitName.size() <= 128
        && data.traitType in ['POSITIF', 'NEGATIF']
        && data.points is number && data.points >= -100 && data.points <= 100
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    // Helper validasi data aplikasi sinkronisasi
    function isValidAppData(data) {
      return data.data is string && data.data.size() <= 1048576
        && data.updatedAt is number
        && (!('isChunked' in data) || data.isChunked is bool)
        && (!('totalChunks' in data) || (data.totalChunks is number && data.totalChunks >= 1 && data.totalChunks <= 50));
    }

    // ===============================================================
    // ATURAN KOLEKSI PRESENSI SISWA (attendance_records & sihadir_attendance_records)
    // ===============================================================
    match /attendance_records/{recordId} {
      allow read: if true;
      allow create: if isValidId(recordId) && isValidAttendanceRecord(incoming());
      // Update diizinkan HANYA jika payload valid DAN ada pembaruan nyata (menolak no-op duplicate writes)
      allow update: if isValidId(recordId) 
        && isValidAttendanceRecord(incoming())
        && isMeaningfulAttendanceUpdate()
        && (isTeacherOrAdmin() || incoming().isRealScan == true || incoming().method in ['QR_SCAN', 'MANUAL']);
      // Hanya peran Admin yang dapat menghapus
      allow delete: if isAdmin();
    }

    match /sihadir_attendance_records/{recordId} {
      allow read: if true;
      allow create: if isValidId(recordId) && isValidAttendanceRecord(incoming());
      allow update: if isValidId(recordId) 
        && isValidAttendanceRecord(incoming())
        && isMeaningfulAttendanceUpdate()
        && (isTeacherOrAdmin() || incoming().isRealScan == true || incoming().method in ['QR_SCAN', 'MANUAL']);
      allow delete: if isAdmin();
    }

    match /attendance/{recordId} {
      allow read: if true;
      allow create: if isValidId(recordId) && isValidAttendanceRecord(incoming());
      allow update: if isValidId(recordId) && isValidAttendanceRecord(incoming()) && isTeacherOrAdmin();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // DOKUMEN AGREGASI & SINKRONISASI DATA SEKOLAH (sihadir_app_data)
    // ===============================================================
    match /sihadir_app_data/{docId} {
      allow read: if true;
      allow create: if isValidId(docId) && isValidAppData(incoming());
      // Tolak penulisan jika isi data identik (mencegah loop auto-save memboroskan kuota)
      allow update: if isValidId(docId) 
        && isValidAppData(incoming())
        && (incoming().data != existing().data || incoming().updatedAt > (existing().updatedAt + 1000))
        && (docId.matches('^sihadir_attendance_.*')
          ? (isTeacherOrAdmin() || incoming().editorRole in ['ADMIN', 'TEACHER', 'GURU', 'ADMIN_GURU'] || request.auth == null)
          : true);
      allow delete: if (docId.matches('^sihadir_attendance_.*') || docId.matches('^sihadir_character_.*'))
        ? isAdmin()
        : (isSignedIn() || isAdmin());
    }

    // ===============================================================
    // ATURAN KOLEKSI PENILAIAN KARAKTER & CATATAN PERILAKU SISWA
    // ===============================================================
    match /character_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && isValidCharacterLog(incoming());
      allow update: if isValidId(logId) && isValidCharacterLog(incoming())
        && (isTeacherOrAdmin() || incoming().editorRole in ['ADMIN', 'TEACHER', 'GURU', 'ADMIN_GURU']);
      allow delete: if isAdmin() || isTeacher();
    }

    match /sihadir_character_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && isValidCharacterLog(incoming());
      allow update: if isValidId(logId) && isValidCharacterLog(incoming())
        && (isTeacherOrAdmin() || incoming().editorRole in ['ADMIN', 'TEACHER', 'GURU', 'ADMIN_GURU']);
      allow delete: if isAdmin() || isTeacher();
    }

    match /behavior_notes/{noteId} {
      allow read: if true;
      allow create, update: if isValidId(noteId) && (isTeacherOrAdmin() || incoming().editorRole in ['ADMIN', 'TEACHER', 'GURU', 'ADMIN_GURU']);
      allow delete: if isAdmin() || isTeacher();
    }

    match /student_character_summaries/{studentId} {
      allow read: if true;
      allow create, update: if isValidId(studentId) && (isTeacherOrAdmin() || incoming().editorRole in ['ADMIN', 'TEACHER', 'GURU', 'ADMIN_GURU']);
      allow delete: if isAdmin();
    }

    // ===============================================================
    // ATURAN AUDIT LOGS (audit_logs & sihadir_audit_logs)
    // ===============================================================
    match /audit_logs/{logId} {
      allow read: if isTeacherOrAdmin();
      allow create: if isValidId(logId);
      allow update, delete: if false; // Mutlak immutable
    }

    match /sihadir_audit_logs/{logId} {
      allow read: if isTeacherOrAdmin();
      allow create: if isValidId(logId);
      allow update, delete: if false; // Mutlak immutable
    }

    // Aturan fallback
    match /{document=**} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
  }
}
